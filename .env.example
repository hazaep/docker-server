# ================================================
# ======        ENVIRONMENT (example)        ======
# ================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ================================================

# --- CONFIG ---
TZ=America/Ciudad_Juarez
DOMINIO=your-domain.com
PROJECT_PATH=/home/your-user

# ================================================
# ======       🔴 FUNDACIÓN                 ======
# ================================================

# --- POSTGRES ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<generate_64_random_chars>
POSTGRES_DB=postgres

# --- REDIS ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<generate_32_random_chars>
REDIS_URL=redis://default:<same_redis_password>@redis:6379

# --- CLOUDFLARED ---
CLOUDFLARE_TUNNEL_TOKEN=<cloudflare_zero_trust_tunnel_token>

# --- TRAEFIK ---
# Generate with: htpasswd -nb admin <password>
TRAEFIK_AUTH=admin:<htpasswd_hash>

# ================================================
# ======       🟠 CORE                      ======
# ================================================

# --- N8N ---
N8N_ENCRYPTION_KEY=<generate_32_random_chars>
N8N_RUNNERS_TOKEN=<generate_64_random_chars>
# N8N_BASIC_AUTH_ACTIVE=true       # deprecated — use runners auth
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=<generate_32_random_chars>
N8N_POSTGRES_HOST=postgres
N8N_POSTGRES_PORT=5432
N8N_REDIS_HOST=redis
N8N_REDIS_PORT=6379
N8N_REDIS_PASSWORD=<same_redis_password>

# --- OPEN WEBUI ---
JINA_API_KEY=<jina_api_key>

# --- OPEN TERMINAL ---
OPEN_TERMINAL_API_KEY=<generate_64_random_chars>
OPEN_TERMINAL_PACKAGES=syncthing
OPEN_TERMINAL_PIP_PACKAGES=requests numpy pandas

# --- NOCODB ---
NOCO_ADMIN_EMAIL=user@example.com
NOCO_ADMIN_PASSWORD=<strong_password_16_chars>
NOCO_GOOGLE_CLIENT=<google_oauth_client_id>
NOCO_GOOGLE_SECRET=<google_oauth_secret>
NOCO_PUBLIC_URL=https://nocodb.${DOMINIO}
NOCO_DB_NAME=noco_db
NOCO_DB_USER=nocodb
NOCO_DB_PW=<generate_24_random_chars>
NOCO_REDIS_URL=redis://default:<redis_password>@redis:6379

# --- WATCHTOWER ---
WATCHTOWER_CLEANUP=true
WATCHTOWER_REMOVE_VOLUMES=false
WATCHTOWER_SCHEDULE=0 0 4 * * *

# ================================================
# ======       🟡 EXTENSIÓN                 ======
# ================================================

# --- MINIO ---
MINIO_R_USER=minioadmin
MINIO_R_PASS=<strong_password_16_chars>

# --- FLOWISE ---
FLOWISE_USERNAME=user@example.com
FLOWISE_PASSWORD=<strong_password_16_chars>
FLOWISE_MODE=queue
FLOWISE_PORT=3000
FLOWISE_WORKER_PORT=5566
FLOWISE_REDIS_PASSWORD=<redis_password>
FLOWISE_REDIS_URL=redis://default:<redis_password>@redis:6379
FLOWISE_SHOW_COMMUNITY_NODES=true
FLOWISE_DATABASE_TYPE=postgres
FLOWISE_DATABASE_HOST=postgres
FLOWISE_DATABASE_PORT=5432
FLOWISE_DATABASE_NAME=flowise
FLOWISE_DATABASE_USER=flowise
FLOWISE_DATABASE_PASSWORD=<generate_24_random_chars>
FLOWISE_JWT_AUTH_TOKEN_SECRET=<generate_64_random_hex>
FLOWISE_JWT_REFRESH_TOKEN_SECRET=<generate_64_random_hex>
FLOWISE_JWT_ISSUER=ISSUER
FLOWISE_JWT_AUDIENCE=AUDIENCE
FLOWISE_JWT_TOKEN_EXPIRY_IN_MINUTES=300
FLOWISE_JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=4500
FLOWISE_ENABLE_METRICS=true
FLOWISE_METRICS_PROVIDER=prometheus

# --- OIKB ---
OIKB_OPEN_WEBUI_API_KEY=<open_webui_api_key>
OIKB_API_KEY=<generate_64_random_chars>
KB_CODEX_ID=<kb_uuid>
KB_N8N_DOCS_ID=<kb_uuid>
KB_DOCKER_SERVER_ID=<kb_uuid>
# KB_OBSIDIAN_ID=<kb_uuid>
# SYNC_PATH=/home/user/sync  (uncomment and set to your synced directories root)

# --- CHROME ---
CHROME_TIMEOUT=10000
CHROME_CONCURRENT=10
CHROME_TOKEN=chrome_token
CHROME_EXIT_FAILURE=true
CHROME_HEALTH_CHECK=true

# ================================================
# ======       🟢 HERRAMIENTA               ======
# ================================================

# --- PGADMIN ---
PGADMIN_DEFAULT_EMAIL=admin@${DOMINIO}
PGADMIN_DEFAULT_PASSWORD=<strong_password_16_chars>

# --- PHPMYADMIN / MARIADB ---
MARIA_ROOT_PASS=<generate_32_random_chars>
MARIA_PASS=<generate_32_random_chars>

# --- PGBACKUP ---
BACKUP_HOST=postgres
BACKUP_DATABASE=n8n,arcane,vaultwarden
BACKUP_USER=postgres
BACKUP_PASSWORD=<same_postgres_password>

# --- VAULTWARDEN ---
VAULTWARDEN_WEBSOCKET_ENABLED=true
VAULTWARDEN_SIGNUPS_ALLOWED=true
VAULTWARDEN_DATABASE_URL=postgresql://vaultwarden:<generate_32_random_chars>@postgres:5432/vaultwarden
# Generate with: docker compose exec vaultwarden ./vaultwarden hash
VAULTWARDEN_ADMIN_TOKEN=<argon2_hash>

# ================================================
# ======       ⚪ OBSERVABILIDAD            ======
# ================================================
# (no additional env vars required — all use TZ)

# ================================================
# ======       🟣 EXPERIMENTO               ======
# ================================================

# --- ARCANE ---
ARCANE_PG_USER=arcane
ARCANE_PG_PASSWORD=<generate_32_random_chars>
ARCANE_PG_DB=arcane
ARCANE_ENCRYPTION_KEY=<generate_64_random_hex>
ARCANE_JWT_SECRET=<generate_64_random_hex>

# --- REACTIVE RESUME ---
RR_PORT=3000
RR_ENV=production
RR_PUBLIC_URL=https://resume.${DOMINIO}
RR_STORAGE_URL=http://minio:9000/default
RR_CHROME_TOKEN=chrome_token
RR_CHROME_URL=ws://chrome:3000
RR_DB_URL=postgresql://resume:<generate_24_random_chars>@postgres:5432/resume
RR_ACCESS_TOKEN=<generate_64_random_hex>
RR_REFRESH_TOKEN=<generate_64_random_hex>
RR_MAIL_FROM=noreply@localhost
RR_STORAGE_ENDPOINT=minio
RR_STORAGE_PORT=9000
RR_STORAGE_BUCKET=resume
RR_STORAGE_ACCESS_KEY=<same_minio_user>
RR_STORAGE_SECRET_KEY=<same_minio_password>
RR_STORAGE_USE_SSL=false
RR_STORAGE_SKIP_BUCKET_CHECK=false
RR_REDIS_URL=redis://default:<redis_password>@redis:6379
RR_GOOGLE_CLIENT_ID=<google_oauth_client_id>
RR_GOOGLE_CLIENT_SECRET=<google_oauth_secret>
RR_GOOGLE_CALLBACK_URL=https://resume.${DOMINIO}/api/auth/callback/google
RR_GITHUB_CLIENT_ID=<github_oauth_client_id>
RR_GITHUB_CLIENT_SECRET=<github_oauth_secret>
RR_GITHUB_CALLBACK_URL=https://resume.${DOMINIO}/api/auth/callback/github
RR_APP_URL=https://resume.${DOMINIO}
RR_AUTH_SECRET=<generate_64_random_chars>
RR_ENCRYPTION_SECRET=<generate_64_random_hex>
